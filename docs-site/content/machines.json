{
  "machines": [
    {
      "id": "ingest",
      "label": {
        "vi": "Dây chuyền nạp tài liệu",
        "en": "The ingestion line",
        "fr": "La chaîne d'ingestion"
      },
      "inlet": {
        "label": {
          "vi": "Một PDF — hoặc một tệp Office, được chuyển sang PDF trước để mọi thứ phía sau không đổi.",
          "en": "A PDF - or an Office file, converted to PDF first so nothing downstream changes.",
          "fr": "Un PDF - ou un fichier Office, converti d'abord en PDF pour que rien ne change en aval."
        }
      },
      "parts": [
        {
          "id": "convert",
          "component": "ingest-intake",
          "phases": [
            "p1",
            "p5"
          ],
          "label": {
            "vi": "Chuyển định dạng",
            "en": "Convert",
            "fr": "Convertir"
          }
        },
        {
          "id": "extract",
          "component": "ingest-page-analysis",
          "phases": [
            "p1"
          ],
          "label": {
            "vi": "Rút text và render trang",
            "en": "Extract text, render pages",
            "fr": "Extraire le texte, rendre les pages"
          }
        },
        {
          "id": "layout",
          "component": "ingest-page-analysis",
          "phases": [
            "p1",
            "p2"
          ],
          "label": {
            "vi": "Phân tích bố cục",
            "en": "Analyse the layout",
            "fr": "Analyser la mise en page"
          }
        },
        {
          "id": "regions",
          "component": "ingest-page-analysis",
          "phases": [
            "p2"
          ],
          "label": {
            "vi": "Khoanh vùng bảng",
            "en": "Find the table regions",
            "fr": "Repérer les régions de tableau"
          }
        },
        {
          "id": "tables",
          "component": "ingest-tables",
          "phases": [
            "p2"
          ],
          "label": {
            "vi": "Đọc bảng thành ba biểu diễn",
            "en": "Read tables into three representations",
            "fr": "Lire les tableaux en trois représentations"
          }
        },
        {
          "id": "figures",
          "component": "ingest-figures",
          "phases": [
            "p2"
          ],
          "label": {
            "vi": "Đo biểu đồ và bảng màu",
            "en": "Measure charts and palettes",
            "fr": "Mesurer graphiques et palettes"
          }
        },
        {
          "id": "confidence",
          "component": "ingest-confidence",
          "phases": [
            "p3"
          ],
          "label": {
            "vi": "Chấm ba tín hiệu tin cậy",
            "en": "Score the three confidence signals",
            "fr": "Noter les trois signaux de confiance"
          }
        },
        {
          "id": "chunk",
          "component": "index-write",
          "phases": [
            "p1"
          ],
          "label": {
            "vi": "Cắt chunk",
            "en": "Chunk",
            "fr": "Fragmenter"
          }
        },
        {
          "id": "embed",
          "component": "index-write",
          "phases": [
            "p1",
            "p4"
          ],
          "label": {
            "vi": "Sinh vector dense và sparse",
            "en": "Embed, dense and sparse",
            "fr": "Encoder, dense et creux"
          }
        },
        {
          "id": "index",
          "component": "index-write",
          "phases": [
            "p1",
            "p2",
            "p4"
          ],
          "label": {
            "vi": "Ghi Postgres và Qdrant",
            "en": "Write Postgres and Qdrant",
            "fr": "Écrire dans Postgres et Qdrant"
          }
        }
      ],
      "exits": [
        {
          "id": "done",
          "label": {
            "vi": "done — sẵn sàng để hỏi",
            "en": "done - ready to be asked",
            "fr": "done - prête à être interrogée"
          }
        },
        {
          "id": "failed",
          "label": {
            "vi": "failed — kèm lý do đọc được",
            "en": "failed - with a reason to read",
            "fr": "failed - avec un motif à lire"
          }
        },
        {
          "id": "review",
          "label": {
            "vi": "Hàng đợi duyệt — bảng vẫn nằm đó, nhưng câu trả lời không khẳng định số từ nó",
            "en": "The review queue - the table stays, but no answer asserts a number from it",
