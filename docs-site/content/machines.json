        },
        {
          "from": "extract",
          "to": "layout"
        },
        {
          "from": "layout",
          "to": "regions",
          "label": {
            "vi": "trang có bảng",
            "en": "the page holds tables",
            "fr": "la page contient des tableaux"
          }
        },
        {
          "from": "layout",
          "to": "chunk",
          "label": {
            "vi": "chỉ có văn bản",
            "en": "text only",
            "fr": "texte seulement"
          }
        },
        {
          "from": "regions",
          "to": "tables"
        },
        {
          "from": "layout",
          "to": "figures",
          "label": {
            "vi": "trang có hình",
            "en": "the page holds figures",
            "fr": "la page contient des figures"
          }
        },
        {
          "from": "tables",
          "to": "confidence"
        },
        {
          "from": "figures",
          "to": "chunk"
        },
        {
          "from": "confidence",
          "to": "chunk",
          "label": {
            "vi": "mọi tín hiệu đều ổn",
            "en": "every signal is clean",
            "fr": "tous les signaux sont bons"
          }
        },
        {
          "from": "confidence",
          "to": "review",
          "label": {
            "vi": "một tín hiệu nói bản parse này sai",
            "en": "a signal says this parse is wrong",
            "fr": "un signal dit que cette analyse est fausse"
          }
        },
        {
          "from": "chunk",
          "to": "embed"
        },
        {
          "from": "embed",
          "to": "index"
        },
        {
          "from": "index",
          "to": "done"
        },
        {
          "from": "index",
          "to": "failed",
          "label": {
            "vi": "lỗi vĩnh viễn",
            "en": "a permanent error",
            "fr": "une erreur définitive"
          }
        }
      ]
    },
    {
      "id": "query",
      "label": {
        "vi": "Dây chuyền trả lời",
        "en": "The answering line",
        "fr": "La chaîne de réponse"
      },
      "inlet": {
        "label": {
          "vi": "Một câu hỏi — có thể là một mảnh vụn nối tiếp câu trước, nên nó được cô đọng thành câu tự đứng được trước khi đi tiếp.",
          "en": "A question - possibly a fragment following on from the last one, so it is condensed into something self-contained before anything else.",
          "fr": "Une question - peut-être un fragment qui prolonge la précédente, elle est donc condensée en quelque chose d'autonome avant toute autre étape."
        }
      },
      "parts": [
        {
          "id": "condense",
          "component": "query-answer",
          "phases": [
            "p1",
            "p4"
          ],
          "label": {
            "vi": "Cô đọng thành câu tự đứng",
            "en": "Condense into a standalone question",
            "fr": "Condenser en une question autonome"
          }
        },
        {
          "id": "router",
          "component": "query-route-retrieve",
          "phases": [
            "p1",
            "p5"
          ],
          "label": {
            "vi": "Router chọn KB",
            "en": "The router picks the knowledge bases",
            "fr": "Le routeur choisit les bases"
          }
        },
        {
          "id": "retrieve",
          "component": "query-route-retrieve",
          "phases": [
            "p1",
            "p4"
          ],
          "label": {
            "vi": "Truy hồi lai, hợp nhất RRF",
            "en": "Hybrid retrieval, RRF fusion",
            "fr": "Recherche hybride, fusion RRF"
          }
        },
        {
          "id": "rerank",
          "component": "query-route-retrieve",
          "phases": [
            "p1",
            "p4"
          ],
          "label": {
            "vi": "Xếp lại ứng viên",
            "en": "Reorder the candidates",
            "fr": "Réordonner les candidats"
          }
        },
        {
          "id": "assemble",
          "component": "query-answer",
          "phases": [
            "p1",
            "p2"
          ],
          "label": {
            "vi": "Lắp ngữ cảnh có xuất xứ",
            "en": "Assemble the context with provenance",
            "fr": "Assembler le contexte avec sa provenance"
          }
        },
        {
          "id": "generate",
          "component": "query-answer",
          "phases": [
            "p1",
            "p4"
          ],
          "label": {
            "vi": "Sinh câu trả lời, chảy về theo SSE",
            "en": "Generate, streamed over SSE",
            "fr": "Générer, diffusé en SSE"
          }
        },
        {
          "id": "verify",
          "component": "query-verify",
          "phases": [
            "p1",
            "p4"
          ],
          "label": {
            "vi": "Kiểm chứng từng con số",
            "en": "Verify every number",
            "fr": "Vérifier chaque chiffre"
          }
        }
      ],
      "exits": [
        {
          "id": "answered",
          "label": {
            "vi": "Câu trả lời có trích dẫn bấm ngược về ảnh trang",
            "en": "A cited answer that clicks back to the page image",
            "fr": "Une réponse sourcée qui ramène d'un clic à l'image de la page"
          }
        },
        {
          "id": "refused",
          "label": {
            "vi": "Nói thẳng là không tìm thấy — không bịa ra một câu trả lời",
            "en": "Says plainly that nothing was found - rather than inventing one",
            "fr": "Dit franchement que rien n'a été trouvé - plutôt que d'en inventer une"
          }
        },
        {
          "id": "flagged",
          "label": {
            "vi": "Trả lời kèm cờ: có con số không tìm lại được trong nguồn",
            "en": "Answered with a flag: a number could not be found again in the sources",
            "fr": "Répondu avec un drapeau : un chiffre n'a pas pu être retrouvé dans les sources"
          }
        },
        {
          "id": "smalltalk",
          "label": {
            "vi": "Lời chào được trả lời như lời chào, không tìm kiếm gì",
            "en": "A greeting answered as a greeting, with no search at all",
            "fr": "Une salutation à laquelle on répond comme à une salutation, sans aucune recherche"
          }
        }
      ],
      "edges": [
        {
          "from": "condense",
          "to": "smalltalk",
          "label": {
            "vi": "không phải câu hỏi về tài liệu",
            "en": "not a question about the documents",
            "fr": "pas une question sur les documents"
          }
        },
        {
          "from": "condense",
          "to": "router"
        },
        {
          "from": "router",
          "to": "retrieve",
          "label": {
            "vi": "chọn được KB — hoặc router hỏng thì tìm TẤT CẢ, không bao giờ tìm rỗng",
            "en": "knowledge bases chosen - or, when the router fails, search ALL of them, never none",
            "fr": "bases choisies - ou, quand le routeur échoue, chercher dans TOUTES, jamais dans aucune"
          }
        },
        {
          "from": "retrieve",
          "to": "rerank"
        },
        {
          "from": "rerank",
          "to": "assemble",
          "label": {
            "vi": "reranker tắt hoặc không với tới được thì dùng thứ tự dự phòng đa dạng theo tài liệu",
            "en": "with the reranker off or unreachable, the document-diversified fallback ordering is used",
            "fr": "avec le reranker éteint ou injoignable, on utilise l'ordre de repli diversifié par document"
          }
        },
        {
          "from": "assemble",
          "to": "refused",
          "label": {
            "vi": "không có nguồn nào",
            "en": "no source at all",
            "fr": "aucune source du tout"
          }
        },
        {
          "from": "assemble",
          "to": "generate"
        },
        {
          "from": "generate",
          "to": "verify"
        },
        {
          "from": "verify",
          "to": "answered",
          "label": {
            "vi": "mọi con số đều tìm lại được, hoặc suy ra được",
            "en": "every number was found again, or is derivable",
            "fr": "chaque chiffre a été retrouvé, ou est déductible"
          }
        },
        {
          "from": "verify",
          "to": "flagged",
          "label": {
            "vi": "có con số không tìm lại được",
            "en": "a number could not be found again",
            "fr": "un chiffre n'a pas pu être retrouvé"
          }
        }
      ]
    }
  ]
}
