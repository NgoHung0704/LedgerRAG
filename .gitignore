# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Env / secrets
.env
*.local

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/package-lock.json
# TypeScript's incremental build cache — a build artifact that was tracked, so
# every `tsc` run showed up as a change to review
frontend/tsconfig.tsbuildinfo

# Data & runtime artifacts
data/
spike/tables/*/parsed*.json
spike/tables/*/response*.txt
spike/out/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# git worktrees created for isolated task execution
.claude/worktrees/

# docs-site (the architecture page). Its package-lock.json IS tracked —
# `npm ci` in CI requires a committed lockfile, and the `frontend/` rule
# above deliberately only covers the product app.
docs-site/node_modules/
# screenshots from `node tools/shots.mjs` — evidence for a review, not source
docs-site/shots/

# real customer PDFs for the detection gate — never committed
tests/eval/tables/pdfs/*.pdf
# eval transcripts: run artefacts, rewritten every run, and they quote the
# customer documents verbatim — answers, cited passages, the lot. Untracked but
# not ignored meant one `git add -A` away from publishing them.
tests/eval/qa/results/
# the single-file build of the architecture page (a release artefact, not source)
docs-site/dist-standalone/
